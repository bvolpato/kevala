{
  "name": "kevala",
  "version": "0.1.3",
  "description": "Run Laya, Kev, and SemIf-style Qwen3.5 decisions inside a web page, on WebGPU or WebAssembly: typed questions in, option probabilities out, no server.",
  "keywords": [
    "webassembly",
    "webgpu",
    "decision-model",
    "classification",
    "laya",
    "kev",
    "system-one",
    "rust",
    "browser"
  ],
  "homepage": "https://bvolpato.github.io/kevala/",
  "bugs": {
    "url": "https://github.com/bvolpato/kevala/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvolpato/kevala.git"
  },
  "license": "Apache-2.0",
  "author": "Bruno Volpato <brunocvcunha@gmail.com>",
  "type": "module",
  "main": "./js/src/index.js",
  "exports": {
    ".": "./js/src/index.js",
    "./node": "./js/src/node.js",
    "./presets": "./js/src/presets.js",
    "./js/src/*": "./js/src/*"
  },
  "jsdelivr": "./js/src/index.js",
  "unpkg": "./js/src/index.js",
  "files": [
    "js/src/",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "README.md"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@12.5.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "check": "node scripts/check-js.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "scripts/build-wasm.sh",
    "check:wasm": "node scripts/check-wasm.mjs",
    "check:package": "node scripts/check-package.mjs",
    "stage:site": "node scripts/stage-site.mjs",
    "prepack": "scripts/build-wasm.sh",
    "serve": "node scripts/serve.mjs .",
    "smoke": "node scripts/node-smoke.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}

{
  "name": "kevala",
  "version": "0.1.0",
  "description": "Decision models (Laya, Kev-0.8B) in any web page: a zero-dependency Rust engine compiled to WebAssembly, with WebGPU kernels. One import, no server.",
  "keywords": [
    "webassembly",
    "webgpu",
    "decision-model",
    "classification",
    "laya",
    "kev",
    "system-one",
    "rust",
    "browser"
  ],
  "homepage": "https://bvolpato.github.io/kevala/",
  "bugs": {
    "url": "https://github.com/bvolpato/kevala/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvolpato/kevala.git"
  },
  "license": "Apache-2.0",
  "author": "Bruno Volpato <brunocvcunha@gmail.com>",
  "type": "module",
  "main": "./js/src/index.js",
  "exports": {
    ".": "./js/src/index.js",
    "./node": "./js/src/node.js",
    "./presets": "./js/src/presets.js",
    "./js/src/*": "./js/src/*"
  },
  "jsdelivr": "./js/src/index.js",
  "unpkg": "./js/src/index.js",
  "files": [
    "js/src/",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "scripts/build-wasm.sh",
    "serve": "node scripts/serve.mjs . --port=8080",
    "smoke": "node scripts/node-smoke.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
